# ====================================================================
# Smart Home Hub — P4 Hub 默认配置
# JC-ESP32P4-M3-DEV + JD9165BA 1024×600 MIPI DSI + GT911
# ====================================================================

# ─── ESP32-P4 芯片版本 ───
CONFIG_ESP32P4_REV_MIN_0=y

# ─── PSRAM (32MB Octal PSRAM, 200MHz) ───
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
# 内部 RAM 余量优化：lwIP/Wi-Fi 侧缓冲优先放 PSRAM。
# 背景：壁纸首帧后内部 RAM 只剩 ~40KB（最大连续块 15KB），SDIO 的
# 1536B 缓冲池在临界点上会偶发 mempool OOM。该选项把 lwIP 的 pbuf/窗口
# 等大块分配挪到 PSRAM，为 esp_hosted 留出内部 RAM。
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# ─── Flash 大小 16MB ───
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

# ─── 分区表：双 OTA 自定义布局（见 partitions.csv）───
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000
CONFIG_PARTITION_TABLE_MD5=y

# ─── OTA 回滚：新镜像必须显式 mark valid，否则 bootloader 回滚 ───
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# ─── LVGL 颜色深度：RGB565（必须匹配 DPI 面板的像素格式，否则帧缓冲区溢出） ───
CONFIG_LV_COLOR_DEPTH_16=y
# CONFIG_LV_COLOR_DEPTH_24 is not set
CONFIG_LV_CONF_SKIP=y
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_32=y
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_DRAW_THREAD_STACK_SIZE=32768

# ─── 任务栈大小（致命：默认 3584 不够 LCD 初始化） ───
CONFIG_ESP_MAIN_TASK_STACK_SIZE=12288
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

# ─── FreeRTOS ───
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y

# ─── ESP-IDF 实验特性（MIPI DSI 需要） ───
CONFIG_IDF_EXPERIMENTAL_FEATURES=y

# ─── 硬约束（前序工程踩坑经验） ───
CONFIG_ESP_TASK_WDT_PANIC=n
CONFIG_ESP_HOSTED_TRANSPORT_RESTART_ON_FAILURE=n

# ─── 看门狗策略（ADR-017） ───
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
# CONFIG_ESP_TASK_WDT_PANIC is not set   # 不 panic, 仅打日志

# ─── DMA2D（暂关闭 — ISR 与 esp_hosted SDIO 有冲突，后续 WiFi 启用时注意） ───
CONFIG_SMART_HOME_DMA2D_ENABLE=y

# ─── MIPI DSI 配置 ───
CONFIG_SMART_HOME_LCD_RST_GPIO=-1
# DOUBLE_DIRECT：直写面板帧缓冲、只刷脏区。
# 实测（媒体卡已改直角）：DIRECT = draw 13.4ms / dispfps 30；FULL = draw 31.5ms / dispfps 20。
# 2026-10-19 备注：曾怀疑 DIRECT 的局部刷新会露出另一块帧缓冲里的陈旧像素（表现为
# 「亮蓝一瞬」），于是改回 FULL 做 A/B —— 结果 FULL 下**依旧闪**，说明该现象与刷新模式
# 无关，真凶另行定位（见 docs/16 §7.8）。故保留 DIRECT（帧率更优）。
CONFIG_SMART_HOME_LCD_TEAR_AVOID_DOUBLE_DIRECT=y
CONFIG_SMART_HOME_LCD_ROTATE_0=y
CONFIG_SMART_HOME_MIPI_DSI_LANE_BITRATE_MBPS=614

# ─── LVGL 适配器：显示侧 FPS 统计 ───
# 阶段四壁纸帧率排查时曾置 y（配合 SELFTEST 打 dispfps）；收尾后关闭，
# 需要时再打开即可（与 SMART_HOME_STANDBY_SELFTEST 成对使用）。
# CONFIG_ESP_LVGL_ADAPTER_ENABLE_FPS_STATS is not set

# ─── 阶段 0：触摸、摄像头、SD卡 ───
CONFIG_SMART_HOME_TOUCH_ENABLED=y
CONFIG_SMART_HOME_CAMERA_ENABLED=n

# ─── OV5647 摄像头驱动 ───
CONFIG_CAMERA_OV5647=y
CONFIG_CAMERA_OV5647_AUTO_DETECT_MIPI_INTERFACE_SENSOR=y
CONFIG_CAMERA_OV5647_MIPI_RAW8_800X640_50FPS=y
CONFIG_CAMERA_OV5647_CSI_LINESYNC_ENABLE=y

# ─── SD 卡 ───
# CONFIG_SMART_HOME_SDCARD_ENABLED is not set
# SD 卡与 ESP-Hosted 共用 P4 唯一的 SDMMC 主机（卡在 slot0、C6 在 slot1）。
# 以下两项取自官方 coexist 示例
# esp_hosted/examples/mcu_hosted_sdio_sdmmc_combined/mcu_host/sdkconfig.defaults：
#  - FSTAT_BLKSIZE=4096：FATFS 按 4KB 取块，减少共用总线上的小事务；
#  - WIFI_RMT_NVS_ENABLED=n：P4 侧不做 Wi-Fi NVS 落盘（凭据仍由本工程自己的
#    storage 模块保存），避免 Wi-Fi 初始化时的 flash 写打断 SDIO。
CONFIG_FATFS_VFS_FSTAT_BLKSIZE=4096
# CONFIG_WIFI_RMT_NVS_ENABLED is not set

# ─── ESP-Hosted: P4 ↔ C6 SDIO (esp_wifi_remote) ───
# 板载 ESP32-C6 作为无线协处理器，通过 SDIO Slot 1 与 P4 通信
CONFIG_ESP_HOSTED_P4_DEV_BOARD_NONE=y
CONFIG_ESP_HOSTED_IDF_SLAVE_TARGET="esp32c6"
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
CONFIG_ESP_HOSTED_SDIO_SLOT_1=y
CONFIG_ESP_HOSTED_SDIO_SLOT=1
CONFIG_ESP_HOSTED_SDIO_4_BIT_BUS=y
CONFIG_ESP_HOSTED_SDIO_BUS_WIDTH=4
# esp_hosted 3.x 改名：旧 ESP_HOSTED_SDIO_CLOCK_FREQ_KHZ 已不存在（会被静默忽略，
# 实际按默认 40MHz 跑）。40MHz 是阶段八网络 OTA（4.9MB）+ 壁纸并发已验证可用的
# 配置，不要降频：SDIO TX 带宽减半会让 mempool 排空更慢，反而更容易 OOM。
CONFIG_ESP_HOSTED_HOST_SDIO_CLK_KHZ=40000
# SDIO TX/RX 共用 mempool（num_blocks = RX_Q_SIZE + 11）。默认 20 时，
# MQTT 连接瞬间的 discovery+全量状态突发会把池子打空（mempool OOM (TX)），
# 丢包进而让 TCP 写阻塞数十秒。加到 40 给突发留余量（只增内存，不改协议）。
CONFIG_ESP_HOSTED_HOST_SDIO_RX_Q_SIZE=40
# SDIO 引脚（JC-ESP32P4-M3-DEV 实测）
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CMD_SLOT_1=19
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CLK_SLOT_1=18
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D0_SLOT_1=14
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D1_4BIT_BUS_SLOT_1=15
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D2_4BIT_BUS_SLOT_1=16
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D3_4BIT_BUS_SLOT_1=17
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=54
CONFIG_ESP_HOSTED_SDIO_RESET_DELAY_MS=1500

# ─── WiFi ───
CONFIG_SMART_HOME_WIFI_ENABLED=y
CONFIG_SMART_HOME_WIFI_AUTO_CONNECT=y
# ⚠️ 凭据绝不写进本文件（本文件已入库，见 ADR-016）。
# 凭据只允许存在于这两处：
#   1) 生成的 sdkconfig（已被 .gitignore 忽略）→ 用 idf.py menuconfig 填一次
#   2) 运行时经 NVS 下发（storage_save_wifi_cred()）
# Kconfig 默认值为空串；未配置时启动只打印"无凭据，跳过自动连接"。
CONFIG_SMART_HOME_WIFI_SSID=""
CONFIG_SMART_HOME_WIFI_PASSWORD=""

# ─── 摄像头自动预览 ───
# CONFIG_SMART_HOME_CAMERA_PREVIEW_AUTO is not set

# ─── 阶段 2B: P4↔F103 协议栈 UART ───
# UART0=CH340C(烧录), UART2+GPIO46(TX)/47(RX)→F103
CONFIG_SMART_HOME_PROTO_UART_NUM=2
CONFIG_SMART_HOME_PROTO_UART_TX=46
CONFIG_SMART_HOME_PROTO_UART_RX=47
CONFIG_SMART_HOME_PROTO_UART_BAUD=115200
# 自定义分区表（factory 6M + assets 9.9M）
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE is not set

# SD card BinFont is the primary CJK font source; keep built-in CJK disabled.
# CONFIG_LV_FONT_SOURCE_HAN_SANS_SC_14_CJK is not set
# CONFIG_LV_FONT_SOURCE_HAN_SANS_SC_16_CJK is not set
CONFIG_LV_USE_FS_MEMFS=y
CONFIG_LV_FS_MEMFS_LETTER=77

# FATFS LFN：SD 卡字体为长文件名
CONFIG_FATFS_LFN_HEAP=y
# Reicon 导航图标已预生成成 lv_image_dsc_t 位图数组，运行时不需要 SVG/ThorVG。
# 三者关闭以省构建内存；LV_USE_VECTOR_GRAPHIC 关闭后必须同时关闭 ThorVG，
# 否则 lv_draw_vector.c 会 #error（要求 DRAW_SW+THORVG / VG_LITE / NEMA_VG）。
CONFIG_LV_USE_SVG=n
CONFIG_LV_USE_VECTOR_GRAPHIC=n
CONFIG_LV_USE_MATRIX=y
CONFIG_LV_USE_FLOAT=y
CONFIG_LV_USE_THORVG=n
CONFIG_LV_USE_THORVG_INTERNAL=n

# ─── 阶段七：人脸检测模型 ───
# 远距离漏检根因：MSR 输入仅 160×120，800×640 整帧被压缩 5 倍，
# 最小锚点 16px 对应原图约 80px 人脸，小于它的脸连候选框都不会产生。
# ESPDet PICO 416 输入 416×416（压缩 1.92 倍），mAP50-95 0.597（MSR+MNP 0.366），
# P4 实测单帧约 225–230ms；替换后 3 帧扫描约 0.7s。
# CONFIG_FLASH_HUMAN_FACE_DETECT_MSRMNP_S8_V1 is not set
CONFIG_FLASH_ESPDET_PICO_416_416_FACE=y
# CONFIG_HUMAN_FACE_DETECT_MSRMNP_S8_V1 is not set
CONFIG_ESPDET_PICO_416_416_FACE=y
CONFIG_DEFAULT_HUMAN_FACE_DETECT_MODEL=2
